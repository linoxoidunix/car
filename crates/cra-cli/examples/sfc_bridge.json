      {"id": "right2", "dist": {"type": "fixed", "q": 0.1},
       "inputs": [{"from": "left2"}, {"from": "bridge"}], "combine": "or"},
      {"id": "sink", "inputs": [{"from": "right1"}, {"from": "right2"}], "combine": "or"}
    ],
    "criterion": {"target": "sink"}
